{
  "manifest_version": 3,
  "name": "ROLarp",
  "version": "2.0",
  "description": "LARP mode for Roblox – fake Robux, profile stats & more. Visual only.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://web.roblox.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ROLarp",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://web.roblox.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
